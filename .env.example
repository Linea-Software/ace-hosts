# ── ace-hosts configuration ───────────────────────────────────────────
# Copy this file to `.env` and adjust as needed. Every value is optional;
# the defaults shown here are used when a key is missing.

# ── Sources ───────────────────────────────────────────────────────────
# Comma- or newline-separated list of host lists to download. Each entry is
# either a bare URL or "name=url". Leave empty to use the built-in default
# source list (see scripts/download_sources.py).
SOURCES=

# ── Directories & files ───────────────────────────────────────────────
# Where raw downloads are stored.
DOWNLOAD_DIR=downloads
# Where merged output and chunks are written.
OUTPUT_DIR=hosts
# Name of the merged file inside OUTPUT_DIR.
MERGED_FILENAME=merged_hosts.txt
# Optional file with one domain per line to exclude from the merged list.
WHITELIST_FILE=whitelist.txt
# Optional comma-separated list of files/globs to merge instead of
# auto-discovering DOWNLOAD_DIR. Ignored when --input is passed.
INPUT_FILES=

# ── Splitting ─────────────────────────────────────────────────────────
# Maximum chunk size in MiB (GitHub's hard limit is 100 MB; 90 leaves room).
SPLIT_CHUNK_MB=90
# Chunk filename prefix (chunks are named <prefix>00, <prefix>01, ...).
SPLIT_PREFIX=hosts

# ── Merging ───────────────────────────────────────────────────────────
# Remove duplicate domains (true/false).
REMOVE_DUPLICATES=true
# Sort the merged list alphabetically (true/false).
SORT_OUTPUT=true
# IP prefix used for every merged line.
NORMALIZE_IP=127.0.0.1
# Strip comments and blank lines (true/false).
STRIP_COMMENTS=true

# ── Networking ────────────────────────────────────────────────────────
# Request timeout in seconds.
REQUEST_TIMEOUT=30
# Retries per source before giving up.
RETRIES=3
# Exponential backoff base in seconds (backoff * 2^attempt).
RETRY_BACKOFF=2.0
# Delay between sources in seconds (politeness / rate limiting).
RATE_LIMIT_DELAY=1.0
# User-Agent sent with every request.
USER_AGENT=ace-hosts/0.1

# ── Logging ───────────────────────────────────────────────────────────
# DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
